# 复制为 ~/.config/youcansee.env 后填入自己的网关与 Key（Windows 也可使用等价用户配置路径；不要提交到 git / 聊天）

# ============================================================
# 档位说明：max > high > medium > low
# 每档可配多个候选，失败自动切下一个（最多 9 个）。
# 旧变量 YOUCANSEE_API_KEY / BASE_URL / MODEL 自动作为 max 档候选 1。
# ============================================================

# ===== MAX 档（最强，候选 1，必填任意一档即可）=====
YOUCANSEE_MAX_API_KEY=your-api-key
YOUCANSEE_MAX_BASE_URL=https://your-gateway.example.com/v1
YOUCANSEE_MAX_MODEL=gpt-5.6-luna
# MAX 档候选 2（可选）
# YOUCANSEE_MAX_2_API_KEY=your-backup-api-key
# YOUCANSEE_MAX_2_BASE_URL=https://backup-gateway.example.com/v1
# YOUCANSEE_MAX_2_MODEL=gpt-4o

# ===== HIGH 档（候选 1，可选）=====
# YOUCANSEE_HIGH_API_KEY=your-api-key
# YOUCANSEE_HIGH_BASE_URL=https://...
# YOUCANSEE_HIGH_MODEL=...

# ===== MEDIUM 档（候选 1，可选）=====
# YOUCANSEE_MEDIUM_API_KEY=your-api-key
# YOUCANSEE_MEDIUM_BASE_URL=https://...
# YOUCANSEE_MEDIUM_MODEL=...

# ===== LOW 档（本地优先，可选）=====
# 模式：auto（先本地 VLM 再 Windows OCR）/ vlm（只本地 VLM）/ ocr（只 Windows OCR）
YOUCANSEE_LOW_MODE=auto
# 本地 VLM 候选（如 Ollama，无需 Key）
# YOUCANSEE_LOW_BASE_URL=http://127.0.0.1:11434/v1
# YOUCANSEE_LOW_MODEL=llava
# Windows 本地 OCR 无需任何配置，auto/ocr 模式自动启用

# ===== 全局设置 =====
YOUCANSEE_DEFAULT_TIER=max
YOUCANSEE_FORCE_JPEG=1
YOUCANSEE_TIMEOUT=180
